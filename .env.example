# Copy to backend/.env and fill in. Never commit backend/.env.
# All variables use the AIIDS_ prefix (see backend/app/core/config.py).

# development | production  (production refuses to start without a secret key)
AIIDS_ENVIRONMENT=development
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
AIIDS_SECRET_KEY=
AIIDS_ACCESS_TOKEN_MINUTES=60

# SQLite for the prototype; PostgreSQL for multi-user deployment, e.g.
# postgresql+psycopg://aiids:password@localhost:5432/aiids  (pip install psycopg[binary])
AIIDS_DATABASE_URL=sqlite:///./aiids.db

# Comma-separated list of dashboard origins allowed by CORS and WebSocket checks
AIIDS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Set false after creating accounts; admins can still add users
AIIDS_OPEN_REGISTRATION=true

AIIDS_MAX_BATCH_EVENTS=500
AIIDS_MAX_REQUEST_BYTES=1000000
AIIDS_AGENT_BATCHES_PER_MINUTE=120
AIIDS_ONLINE_THRESHOLD_S=60
AIIDS_STALE_THRESHOLD_S=300
AIIDS_ENROLLMENT_CODE_MINUTES=15
AIIDS_DEDUP_WINDOW_MINUTES=15
